   "source": [
    "CREATE OR REPLACE TABLE instacart_clean.aisles AS\n",
    "\n",
    "SELECT\n",
    "    CAST(aisle_id AS INT) AS aisle_id,\n",
    "    LOWER(TRIM(aisle)) AS aisle\n",
    "\n",
    "FROM instacart.aisles\n",
    "\n",
    "WHERE aisle_id IS NOT NULL\n",
    "  AND aisle IS NOT NULL\n",
    "  AND TRIM(aisle) <> '';"
   ]
  }
 ],
